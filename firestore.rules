rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public readable collections
    match /cards/{cardId} {
      allow read: if true;
      allow write: if true;
    }

    match /runners/{regId} {
      allow read: if true;
      allow write: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    match /stories/{storyId} {
      allow read: if true;
      allow write: if true;
    }

    match /site_content/{sectionKey} {
      allow read: if true;
      allow write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
